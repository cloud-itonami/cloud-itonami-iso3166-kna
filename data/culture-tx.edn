#:culture{:id "kna.dish.goat-water", :name "Goat water", :country "KNA", :kind :dish, :summary "Stew of cubed goat meat in a tomato base, served with rice and boiled dasheen leaves; known and eaten in several Caribbean countries, most prominently in Saint Kitts and Nevis.", :url "https://en.wikipedia.org/wiki/Goat_water", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "kna.dish.cook-up", :name "Cook-up (pelau)", :country "KNA", :kind :dish, :summary "Favorite dish of Saint Kitts and Nevis combining chicken, pig tail, saltfish and vegetables with rice and pigeon peas.", :url "https://en.wikipedia.org/wiki/Culture_of_Saint_Kitts_and_Nevis", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "kna.dish.conkies", :name "Conkies", :country "KNA", :kind :dish, :summary "Tamale-like preparation of Saint Kitts and Nevis: cornmeal mixed with grated sweet potato, pumpkin and coconut, wrapped in banana leaves and boiled.", :url "https://en.wikipedia.org/wiki/Culture_of_Saint_Kitts_and_Nevis", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "kna.beverage.csr", :name "Cane Spirit Rothschild (CSR)", :country "KNA", :kind :beverage, :summary "The national drink of Saint Kitts and Nevis, distilled from fresh sugar cane.", :url "https://en.wikipedia.org/wiki/Culture_of_Saint_Kitts_and_Nevis", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "kna.product.sugar-cane", :name "Sugar cane", :country "KNA", :kind :product, :summary "Sugar cane, grown on Saint Kitts since 1640, dominated the local economy for about 365 years until the government closed the sugar industry in 2005.", :url "https://en.wikipedia.org/wiki/Saint_Kitts", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "kna.craft.caribelle-batik", :name "Caribelle Batik (Romney Manor)", :country "KNA", :kind :craft, :summary "Batik enterprise at the historic Romney Manor in the Wingfield Estate on Saint Kitts, now a tourist destination with a botanical garden.", :url "https://en.wikipedia.org/wiki/Romney_Manor", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "kna.festival.st-kitts-music-festival", :name "St. Kitts Music Festival", :country "KNA", :kind :festival, :summary "Festival of popular music held annually in June on St. Kitts, first established in 1996 as the Shak Shak Festival.", :url "https://en.wikipedia.org/wiki/St_Kitts_Music_Festival", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "kna.festival.culturama", :name "Culturama", :country "KNA", :kind :festival, :summary "Nevis' carnival-style cultural festival, established in 1974 and celebrated annually around Emancipation Day in late July/early August with music, food festivals, arts and crafts.", :url "https://en.wikipedia.org/wiki/Culturama", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "kna.heritage.brimstone-hill", :name "Brimstone Hill Fortress National Park", :country "KNA", :kind :heritage, :summary "Well-preserved fortress in Saint Thomas Middle Island Parish on St. Kitts, designated a UNESCO World Heritage Site in 1999.", :url "https://en.wikipedia.org/wiki/Brimstone_Hill_Fortress_National_Park", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
